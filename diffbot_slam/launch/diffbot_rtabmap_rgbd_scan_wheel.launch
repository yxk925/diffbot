<launch>
    <arg name="localization"            default="false"/>
    <arg name="move_forward_only" default="false"/>
    <arg name="local_planner" default="dwa" doc="Local planner can be either dwa, base, teb or pose"/>

    <param name="/rtabmap/rtabmap/Reg/Strategy" type="string" value="2"/>           <!-- 0=Visual, 1=ICP, 2=Visual+ICP -->
    <param name="/rtabmap/rtabmap/Odom/Strategy" type="string" value="1"/>
    <param name="/rtabmap/rtabmap/Icp/CorrespondenceRatio" type="string" value="0.3"/>
    <param name="/rtabmap/rtabmap/Icp/MaxCorrespondenceDistance" type="string" value="0.1"/>
    <param name="/rtabmap/rtabmap/Icp/Iterations" type="string" value="50"/>

    <!-- Common parameters -->
    <arg name="common_args" value="
                --Reg/Strategy 2
                --Odom/Strategy 1
                "/>

    <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
        <arg     if="$(arg localization)" name="args" value="$(arg common_args) --Optimizer/GravitySigma 0.3"/>
        <arg unless="$(arg localization)" name="args" value="$(arg common_args) --Optimizer/GravitySigma 0.3 --delete_db_on_start"/>
        <arg name="subscribe_scan" value="true" />
        <arg name="scan_topic" value="/diffbot/scan" />
        <arg name="rgb_topic" value="/camera/color/image_raw"/>
        <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
        <arg name="camera_info_topic" value="/camera/color/camera_info"/>
        <arg name="depth_camera_info_topic" value="/camera/depth/camera_info"/>
        <arg name="approx_sync" value="true"/>
        <arg name="approx_sync_max_interval" value="0.02"/>
        <art name="use_imu_for_odometry" value="true"/>
        <arg name="imu_topic" value="/imu/data"/>
        <arg name="wait_imu_to_init" value="true"/>
        <arg name="frame_id" value="base_footprint"/>
        <arg name="visual_odometry" value="false"/>
        <arg name="icp_odometry" value="false"/>
        <arg name="odom_topic" value="/diffbot/odom_combined"/>
        <arg name="odom_frame_id" value="odom"/>
        <arg name="vo_frame_id" value="vo_odom"/>
        <arg name="publish_tf_odom" value="false"/>
        <arg name="rtabmap_viz" value="false"/>
        <arg name="rviz" value="false"/>
        <arg name="localization"  value="$(arg localization)"/>


    </include>


</launch>
