<launch>
  <!-- Arguments -->
  <!-- The lua scripts are required for cartographer, unused here -->
  <arg name="configuration_basename" default="diffbot_lds_2d.lua"/>
  <arg name="set_base_frame" default="base_footprint"/>
  <arg name="set_odom_frame" default="odom"/>
  <arg name="set_map_frame"  default="map"/>
  <!-- gmapping expects the laser scan on the scan topic 
       but DiffBot provides this in the diffbot namespace -->
  <arg name="scan_topic"  default="diffbot/scan"/>
  <arg name="move_forward_only" default="false"/>
  <arg name="local_planner" default="dwa" doc="Local planner can be either dwa, base, teb or pose"/>

  <!-- Gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="diffbot_slam_gmapping" output="screen">
    <param name="base_frame" value="$(arg set_base_frame)"/>
    <param name="odom_frame" value="$(arg set_odom_frame)"/>
    <param name="map_frame"  value="$(arg set_map_frame)"/>
    <rosparam command="load" file="$(find diffbot_slam)/config/gmapping_params.yaml" />
    <!-- remappings -->
    <remap from="scan" to="$(arg scan_topic)"/>
  </node>

  <!-- move_base -->
  <include file="$(find diffbot_navigation)/launch/move_base.launch">
    <!-- arg name="model" value="$(arg model)" /-->
    <arg name="local_planner" value="$(arg local_planner)" />
    <arg name="move_forward_only" value="$(arg move_forward_only)"/>
    <arg name="cmd_vel_topic" value="/diffbot/mobile_base_controller/cmd_vel" />
  </include>
</launch>
